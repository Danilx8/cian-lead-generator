# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS Configuration (for production)
CORS_ORIGIN=https://yourdomain.com

# Node Environment
NODE_ENV=development

# Демо-переписки при POST /api/worker/start. В NODE_ENV=production без явного включения не создаются — задайте 1 или true.
SEED_MOCK_DIALOGS=1

# Server
HOST=localhost
PORT=3050

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cian_lead_generator
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=root
REDIS_PASSWORD=

# Browser Services (anti-detect)
LINKEN_SPHERE_PORT=35555
MORE_LOGIN_PORT=
MORE_LOGIN_ID=
MORE_LOGIN_KEY=
VISION_TOKEN=
DOLPHIN_PORT=
DOLPHIN_TOKEN=
ADSPOWER_PATH=
ADSPOWER_TOKEN=
GOLOGIN_TOKEN=
OCTO_TOKEN=
INDIGO_API_URL=https://api.indigobrowser.com
INDIGO_TOKEN=
INDIGO_EMAIL=
INDIGO_PASSWORD=
INDIGO_PASSWORD_MD5=
INDIGO_FOLDER_ID=default
IDENTORY_API_URL=
IDENTORY_TOKEN=
UNDETECTABLE_API_URL=

# OpenAI (перевод текста, src/api/services/translate.service.ts)
OPENAI_API_KEY=

# ML / ИИ-классификация продавца (Anthropic Claude, src/modules/seller-classifier)
ANTHROPIC_API_KEY=
# Модель Claude для классификации (по умолчанию задаётся в коде)
SELLER_CLASSIFIER_MODEL=
# Принудительно выключить классификацию (0/false/no/off). По умолчанию включена при наличии ANTHROPIC_API_KEY.
SELLER_CLASSIFIER_ENABLED=

# Шифрование чувствительных данных в хранилище (AES-256-GCM, src/utils/crypto.util.ts).
# Любая строка-секрет; ключ выводится через scrypt. Без значения шифрование отключено.
ENCRYPTION_KEY=

# Модерация регистрации (ВКР §1.6/§1.7): новые пользователи ждут одобрения админом.
# Выключить: 0/false/no/off. По умолчанию включено.
REGISTRATION_MODERATION=

# SMTP-шлюз для email-уведомлений (ВКР §1.6/§1.7). Без SMTP_HOST уведомления логируются.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cian-lead-generator.local

# K8s / Docker
DOCKER_HOST_IP=host.docker.internal
ADMIN_API_KEY=

# Parser proxy (optional)
PARSER_PROXY=
PROXY_URL=
